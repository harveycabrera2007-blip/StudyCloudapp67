<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSubStudent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Student Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2D3436" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvSubStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="#FFEAA7"
                android:textColor="#D63031"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubAssignment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assignment: Java Project 1"
            android:textColor="#0984E3"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvSubNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes: Finished question 1 to 5"
            android:textColor="#636E72"
            android:layout_marginTop="4dp" />

        <!-- Timestamp View -->
        <TextView
            android:id="@+id/tvSubTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒 Sent: Oct 21, 2026 - 12:08 AM"
            android:textColor="#B2BEC3"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <!-- Check Activity Button -->
        <Button
            android:id="@+id/btnCheckActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check Activity"
            android:backgroundTint="#00B894" />

    </LinearLayout>
</androidx.cardview.widget.CardView>