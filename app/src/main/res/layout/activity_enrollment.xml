<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F6FA">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Cancel &amp; Back"
        android:textSize="16sp"
        android:textColor="#D63031"
        android:textStyle="bold"
        android:layout_gravity="start"
        android:padding="8dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎓 Student Course Enrollment"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#2D3436"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select your degree program. Your section will be automatically assigned (Max 40 students per section)."
        android:textColor="#636E72"
        android:gravity="center"
        android:layout_marginBottom="28dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available Programs:"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerCourses"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:drawable/btn_dropdown"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnConfirmEnroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Complete Enrollment" />

</LinearLayout>