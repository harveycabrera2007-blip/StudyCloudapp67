<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/pink_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="90dp">

        <!-- Back Button -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="@color/pink_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Top Badge / Chip -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StudyCloud Alerts"
            android:background="@drawable/bg_pink_chip"
            android:textColor="@color/pink_primary"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Header Titles -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stay Alerted.\nNever miss a deadline."
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/pink_dark_text"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Central Card Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/pink_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notification Tester"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/pink_dark_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap a button below to test how different system alerts trigger on your device."
                    android:textColor="#636E72"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp" />

                <!-- Button 1: Toast -->
                <Button
                    android:id="@+id/btnToastAlert"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Show Toast Message"
                    android:backgroundTint="@color/pink_accent"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Button 2: Status Bar Push Notification -->
                <Button
                    android:id="@+id/btnPushNotification"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Push System Notification"
                    android:backgroundTint="@color/pink_primary"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Button 3: Success Dialog -->
                <Button
                    android:id="@+id/btnSuccessAlert"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Show Success Alert"
                    android:backgroundTint="#00B894"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Button 4: Warning Alert -->
                <Button
                    android:id="@+id/btnWarningAlert"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Show Warning Alert"
                    android:backgroundTint="#D63031"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>