<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission required for System Push Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyCloudApp">

        <!-- Main Launcher Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth & Registration -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Student Screens -->
        <activity
            android:name=".StudentDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".EnrollmentActivity"
            android:exported="false" />
        <activity
            android:name=".SubmitWorkActivity"
            android:exported="false" />
        <activity
            android:name=".StudentHistoryActivity"
            android:exported="false" />

        <!-- Teacher Screens -->
        <activity
            android:name=".TeacherDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".CreateAssignmentActivity"
            android:exported="false" />
        <activity
            android:name=".ManageCoursesActivity"
            android:exported="false" />
        <activity
            android:name=".UploadMaterialActivity"
            android:exported="false" />
        <activity
            android:name=".ReviewSubmissionsActivity"
            android:exported="false" />

        <!-- Admin Screens -->
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ManageUsersActivity"
            android:exported="false" />

        <!-- Pink Theme Notification Center -->
        <activity
            android:name=".NotificationCenterActivity"
            android:exported="false" />

    </application>

</manifest>